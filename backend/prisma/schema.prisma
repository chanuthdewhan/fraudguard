// Prisma schema for FraudGuard.
// A Transaction and the Prediction the ML service returned for it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums enforce valid values at the database level, not just in application
// code - a bug that somehow bypasses Zod/Pydantic validation still can't
// insert an invalid type or risk tier.
enum TransactionType {
  CASH_IN
  CASH_OUT
  DEBIT
  PAYMENT
  TRANSFER
}

enum RiskTier {
  low
  medium
  high
}

model Transaction {
  id             String          @id @default(uuid())
  step           Int
  type           TransactionType
  amount         Float
  nameOrig       String
  oldBalanceOrg  Float
  newBalanceOrg  Float
  nameDest       String
  oldBalanceDest Float
  newBalanceDest Float
  createdAt      DateTime        @default(now())

  prediction Prediction?

  @@index([createdAt(sort: Desc)])
}

model Prediction {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  riskScore     Float
  riskTier      RiskTier

  // JSONB - stores { baseValue: number, topFeatures: [{feature, value}] },
  // Kept as JSON rather than rigid columns since topFeatures is variable length.
  explanation Json
  createdAt   DateTime @default(now())

  @@index([riskTier])
}
