generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

model Transaction {
  id               String       @id @default(uuid())
  step             Int
  type             String
  amount           Float
  nameOrig         String
  oldbalanceOrg    Float
  newbalanceOrig   Float
  nameDest         String
  oldbalanceDest   Float
  newbalanceDest   Float
  isFraud          Boolean      @default(false)
  isFlaggedFraud   Boolean      @default(false)
  riskScore        Int          @default(0)
  riskTier         RiskTier     @default(LOW)
  fraudProbability Float        @default(0.0)
  status           ReviewStatus @default(PENDING)
  explanation      Json?
  analystNotes     String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([riskTier])
  @@index([status])
  @@index([createdAt])
  @@index([riskScore])
}
